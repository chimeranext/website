---
import type { Venture } from "../data/ventures.ts";
const { v } = Astro.props as { v: Venture };
---
<article class="flex flex-col rounded-xl border border-surface-border bg-surface-card p-5">
  <div class="mb-3 flex flex-wrap gap-2">
    {v.industries.map((i) => (
      <span class="rounded-full border border-arcane/60 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-arcaneSoft">{i}</span>
    ))}
    <span class="rounded-full border border-surface-border px-2.5 py-0.5 text-xs tracking-wide text-text-secondary">{v.market}</span>
  </div>
  <h3 class="font-epic text-lg font-semibold text-text-primary">{v.name}</h3>
  <p class="mt-1 max-w-prose font-semibold text-text-primary">{v.uvp}</p>
  <p class="mt-2 max-w-prose flex-1 text-sm text-text-secondary">{v.purpose}</p>
  <p class="mb-1.5 mt-3 text-xs font-semibold uppercase tracking-wide text-text-secondary">Built on</p>
  <div class="mb-4 flex flex-wrap gap-1.5">
    {v.builtOn.map((b) => (
      <a href={`#stack`} class:list={["rounded-md border px-2 py-0.5 font-mono text-xs", b.confirmed ? "border-mana/50 text-manaSoft" : "border-dashed border-surface-border text-text-secondary"]}>{b.slug}</a>
    ))}
  </div>
  <a href={v.domain} class="self-start rounded-lg border border-brand-primary px-4 py-2 text-sm text-brand-primary hover:bg-brand-primary/10">Learn More →</a>
</article>
